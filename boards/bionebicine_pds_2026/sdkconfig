# Use the external 32.768kHz crystal on IO15/IO16 for RTC_SLOW_CLK instead of ESP-IDF's
# default internal RC oscillator. Falls back to the internal oscillator automatically if the
# crystal fails to start (see esp_hw_support/port/esp32s3/Kconfig.rtc).
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_RTC_CLK_CAL_CYCLES=3000

# adafruit/circuitpython#11686: dedicated hardware watchdog for the external crystal above.
# If it stalls, RTC_CNTL automatically switches RTC_SLOW_CLK to a calibrated backup clock,
# keeping this board's own RTC_WDT (used during microcontroller.reset()) on a live clock
# instead of one that may be stalled.
CONFIG_ESP_XT_WDT=y

# NimBLE's GATT (robust) caching / Database Hash support (BLE 5.1). Without it, a bonded
# central that already cached this board's attribute table has no standards-compliant way
# to learn the table changed across a reboot - CircuitPython only signals "Service Changed"
# on a soft reload with services already running (common-hal/_bleio/__init__.c's
# bleio_reset()), never on a hard reset or reflash, which is the only kind this board ever
# does. With this on, NimBLE hashes the real attribute table and compares it against what
# each bonded peer last saw on every reconnect, so a central correctly redoes discovery
# instead of trusting a stale handle map after a reflash changes the table's shape.
CONFIG_BT_NIMBLE_GATT_CACHING=y
